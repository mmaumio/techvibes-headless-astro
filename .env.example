# Copy to .env for local development (never commit .env)

# WordPress that supplies blog posts, legal pages and job listings
WP_URL=https://techvibesit.com

# Keep search engines out (true until this build replaces the live site)
SITE_NOINDEX=true

# Cloudflare Turnstile site key for the contact form (empty = no spam check widget).
# Test key that always passes: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
