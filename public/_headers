# Cloudflare Pages response headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed build assets never change, so browsers can cache them for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the test copy out of search results (preview URLs and the test subdomain).
# The live domain is controlled by SITE_NOINDEX instead, see README.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
