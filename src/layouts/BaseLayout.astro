---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/onest/600.css';
import '../styles/global.css';

import BrandDefs from '../components/BrandDefs.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { company, NOINDEX } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Full <head> markup from Rank Math, used as-is for WordPress-driven pages. */
  seoHead?: string | null;
}

const {
  title,
  description = 'We at TechVibes IT help SMEs automate, scale, and compete with smart technology.',
  image,
  type = 'website',
  seoHead,
} = Astro.props;

const fullTitle = title.includes('TechVibes') ? title : `${title} - ${company.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0C1A24" />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    {seoHead ? (
      <Fragment set:html={seoHead} />
    ) : (
      <>
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:site_name" content={company.name} />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        {image && <meta property="og:image" content={image} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <BrandDefs />
    <a href="#content" class="sr-only">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      // Fade sections in as they scroll into view (skipped for reduced motion).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-shown');
              e.target.classList.remove('is-hidden');
              // Hand transitions back to the element's own hover styles.
              setTimeout(() => e.target.classList.remove('is-shown'), 800);
              io.unobserve(e.target);
            }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => {
          if (el.getBoundingClientRect().top > window.innerHeight) {
            el.classList.add('is-hidden');
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>
