---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import Mark from '../components/Mark.astro';
import SiteImage from '../components/SiteImage.astro';

// Photos: src/assets/images/<image>.jpg (e.g. team-albab.jpg)
const team = [
  { name: 'Albab Tasnim Hossain', role: 'Director & Head of Sales', image: 'team-albab' },
  { name: 'Muntasir M. Aumio', role: 'Founder and Director', image: 'team-muntasir' },
  { name: 'Md Khairul Islam', role: 'UIUX Designer', image: 'team-khairul' },
];

const stats = [
  { value: '500+', label: 'Clients served', color: '#1B9C85' },
  { value: '3000+', label: 'End users', color: '#159FA8' },
  { value: '4.95', label: '5 stars rating, average out of 5', color: '#2A74CE' },
  { value: '15+', label: 'Years of experience', color: '#0C1A24' },
];

---
<BaseLayout title="About Us" description="TechVibes IT drives digital transformation for SMEs with AI, automation, and innovation.">
  <PageHero eyebrow="About Us" title="Driving digital transformation for SMEs with AI, automation, and innovation." wide />

  <section>
    <div class="container section about-grid">
      <div data-reveal class="stack" style="gap:18px">
        <span class="eyebrow">What we do</span>
        <h2 class="h2">We help SMEs scale with AI solutions for digital growth.</h2>
        <Mark size={110} style="margin-top:20px;opacity:.9" />
      </div>
      <div data-reveal class="stack" style="gap:22px">
        <p class="body-lg">At TechVibes, we specialize in empowering SMEs with AI-driven solutions that fuel digital growth. Our comprehensive services include custom website and app development, AI automation tools, and data-driven insights, all designed to streamline operations, enhance customer experiences, and drive business efficiency.</p>
        <p class="body-lg">With a focus on innovation and scalability, we help businesses navigate the digital landscape, optimize workflows, and unlock new growth opportunities. Let us partner with you to transform your business and stay ahead in a competitive market.</p>
      </div>
    </div>
  </section>

  <section aria-label="Statistics" style="border-top:1px solid #EAEFF0">
    <div class="container stats">
      {stats.map((s) => (
        <div class="stat" style={`border-left-color:${s.color}`}>
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section--soft">
    <div class="container section stack" style="gap:clamp(40px,5vw,56px)">
      <div data-reveal class="stack" style="gap:18px;max-width:760px">
        <span class="eyebrow">Meet the team</span>
        <h2 class="h2">TechVibes heroes</h2>
      </div>
      <div class="grid-auto" style="--min:280px">
        {team.map((m) => (
          <figure data-reveal class="card team-card">
            <div class="team-card__photo">
              <SiteImage name={m.image} alt={`${m.name}, ${m.role}`} position="50% 25%" sizes="(min-width: 1240px) 400px, (min-width: 700px) 50vw, 100vw" />
            </div>
            <figcaption class="team-card__body">
              <h3 class="h3" style="font-size:22px">{m.name}</h3>
              <span style="font-size:15px;color:var(--muted)">{m.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .about-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px clamp(48px, 7vw, 112px); align-items: start;
  }
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 40px;
    padding-top: clamp(64px, 8vw, 104px); padding-bottom: clamp(64px, 8vw, 104px);
  }
  .stat { display: flex; flex-direction: column; gap: 10px; padding-left: 20px; border-left: 2px solid; }
  .stat__value {
    font-family: var(--font-display); font-size: clamp(44px, 5vw, 68px); font-weight: 600;
    letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums;
  }
  .stat__label { font-size: 16px; color: var(--text); }
  .team-card { margin: 0; overflow: hidden; }
  .team-card__photo { position: relative; aspect-ratio: 4 / 5; background: #E3EAEA; }
  .team-card__body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 4px; }
</style>
