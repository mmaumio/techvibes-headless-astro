---
// Blog posts and block-editor pages (legal pages etc.) from WordPress,
// served at the same URLs as on the live site: /post-slug/ and /page-slug/.
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import {
  getPosts, getContentPages, getSeoHead, decode, featuredImage, postTerms, postAuthor, formatDate, localiseLinks,
} from '../lib/wp';

export async function getStaticPaths() {
  const [posts, pages] = await Promise.all([getPosts(), getContentPages()]);
  return [...posts, ...pages].map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const isPost = entry.type === 'post';
const title = decode(entry.title?.rendered);
const img = isPost ? featuredImage(entry) : null;
const cats = isPost ? postTerms(entry, 'category') : [];
const tags = isPost ? postTerms(entry, 'post_tag') : [];
const author = isPost ? postAuthor(entry) : null;
const seoHead = await getSeoHead(entry.link);
const description = decode(entry.excerpt?.rendered ?? '').replace(/\s+/g, ' ').trim().slice(0, 160) || undefined;

const related = isPost ? (await getPosts()).filter((p) => p.id !== entry.id).slice(0, 2) : [];
---
<BaseLayout title={title} description={description} image={img?.source_url} type={isPost ? 'article' : 'website'} seoHead={seoHead}>
  <article>
    <header class="page-hero">
      <div class="page-hero__grid" aria-hidden="true"></div>
      <div class="container">
        <div class="page-hero__inner" style="max-width:960px">
          {isPost ? (
            <div class="post-meta">
              <a href="/blog/">Blog</a>
              <span aria-hidden="true">/</span>
              <time datetime={entry.date}>{formatDate(entry.date)}</time>
              {cats.map((c) => <a href={c.path} class="post-meta__cat">{c.name}</a>)}
            </div>
          ) : (
            <span class="eyebrow eyebrow--dot">TechVibes IT</span>
          )}
          <h1 class="h1" style="font-size:clamp(34px,4.6vw,60px)" set:html={entry.title?.rendered} />
          {author && <span style="font-size:16px;color:var(--muted)">By <a href={author.path} class="post-author">{author.name}</a></span>}
          {!isPost && entry.modified && <span class="mono" style="font-size:12.5px;color:var(--muted)">Last updated {formatDate(entry.modified)}</span>}
        </div>
      </div>
    </header>

    <div class="container section" style="padding-top:clamp(40px,6vw,72px)">
      {img?.source_url && (
        <figure class="post-cover">
          <img src={img.source_url} alt={img.alt_text || ''} width={img.media_details?.width} height={img.media_details?.height} decoding="async" />
        </figure>
      )}
      <div class="wp-content" style="max-width:760px" set:html={localiseLinks(entry.content?.rendered)} />
      {tags.length > 0 && (
        <div class="post-tags" aria-label="Tags">
          <span class="mono">Tags</span>
          {tags.map((t) => <a href={t.path}>#{t.name}</a>)}
        </div>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section--soft">
      <div class="container section stack" style="gap:32px">
        <h2 class="h2" style="font-size:clamp(28px,3.2vw,40px)">More from the blog</h2>
        <div class="grid-auto" style="--min:320px">
          {related.map((p) => (
            <a href={`/${p.slug}/`} class="card" style="padding:26px;gap:10px">
              <time class="mono" style="font-size:12px;color:var(--muted)" datetime={p.date}>{formatDate(p.date)}</time>
              <h3 class="h3" style="font-size:21px;line-height:1.3" set:html={p.title?.rendered} />
              <span class="link-arrow" style="margin-top:auto;padding-top:8px">Read More →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {isPost && <CTA />}
</BaseLayout>

<style>
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .post-meta a { color: var(--teal-dark); }
  .post-meta__cat { padding: 4px 9px; border-radius: 6px; background: #F0F7F6; color: var(--teal-dark); }
  .post-meta__cat:hover { background: #E1F1EE; color: var(--teal-dark); }
  .post-author { color: var(--ink); font-weight: 500; }
  .post-author:hover { color: var(--teal-dark); text-decoration: underline; }
  .post-tags { max-width: 760px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14.5px; }
  .post-tags .mono { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .post-tags a { padding: 4px 10px; border-radius: 6px; background: var(--soft); color: var(--teal-dark); }
  .post-cover { margin: 0 0 clamp(32px, 5vw, 56px); max-width: 960px; }
  .post-cover img { width: 100%; border-radius: 18px; display: block; }
</style>
