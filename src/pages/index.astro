---
// Homepage.
import BaseLayout from '../layouts/BaseLayout.astro';
import SelectedWork from '../components/SelectedWork.astro';
import CTA from '../components/CTA.astro';
import SiteImage from '../components/SiteImage.astro';
import '../styles/home.css';
---
<BaseLayout
  title="TechVibes IT - AI-Powered Technology for Businesses Ready to Grow"
  description="We design, build, and scale digital products, eCommerce experiences, and AI-powered solutions that help ambitious businesses work smarter and grow faster."
>
<section data-screen-label="Hero" style="position:relative;overflow:hidden;background:#FFFFFF">
  <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#EEF2F2 1px,transparent 1px),linear-gradient(90deg,#EEF2F2 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse 80% 70% at 70% 30%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse 80% 70% at 70% 30%,#000 30%,transparent 80%)"></div>
  <div aria-hidden="true" style="position:absolute;right:-12%;top:-30%;width:760px;height:760px;border-radius:50%;background:radial-gradient(circle,rgba(21,159,168,.16) 0%,rgba(42,116,206,.07) 45%,transparent 70%);transform:translateY(0px)" data-parallax></div>
  <div style="position:relative;max-width:1240px;margin:0 auto;padding:clamp(56px,9vw,112px) clamp(20px,4vw,40px) clamp(72px,10vw,128px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:clamp(48px,6vw,80px);align-items:center">
    <div style="display:flex;flex-direction:column;gap:28px">
      <div style="display:flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.12em;text-transform:uppercase;color:#137565">
        <span style="width:8px;height:8px;border-radius:2px;background:#1B9C85"></span>UK technology company
      </div>
      <h1 style="font-family:Manrope,sans-serif;margin:0;font-size:clamp(42px,6.2vw,80px);font-weight:600;letter-spacing:-0.045em;line-height:1.0;text-wrap:balance">AI-Powered Technology for Businesses <span style="background:linear-gradient(100deg,#1B9C85 0%,#159FA8 45%,#2A74CE 100%);-webkit-background-clip:text;background-clip:text;color:transparent">Ready to Grow</span></h1>
      <p style="margin:0;font-size:clamp(17px,1.5vw,20px);line-height:1.55;color:#3C4B55;max-width:560px;text-wrap:pretty">We design, build, and scale digital products, eCommerce experiences, and AI-powered solutions that help ambitious businesses work smarter and grow faster.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;padding-top:4px">
        <a class="hv-1" href="/contact/" style="display:inline-flex;align-items:center;gap:10px;height:54px;padding:0 26px;border-radius:12px;background:#0C1A24;color:#FFFFFF;font-size:16.5px;font-weight:500;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 8px 24px -8px rgba(12,26,36,.45);transition:transform .2s ease,background .2s ease">Start Your Project <span aria-hidden="true" style="color:#6FD3C0">→</span></a>
        <a class="hv-2" href="#services" style="display:inline-flex;align-items:center;height:54px;padding:0 24px;border-radius:12px;background:#FFFFFF;color:#0F1E2A;font-size:16.5px;font-weight:500;border:1px solid #D2DADD;transition:border-color .2s ease,transform .2s ease">Explore Our Services</a>
      </div>
    </div>

    <div class="hero-visual" style="position:relative">
      <div style="background:rgba(255,255,255,.82);backdrop-filter:blur(10px);border:1px solid #DCE3E5;border-radius:18px;box-shadow:0 30px 60px -30px rgba(12,26,36,.28),0 1px 2px rgba(12,26,36,.05);padding:22px;display:flex;flex-direction:column;gap:6px">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:2px 4px 14px;border-bottom:1px solid #EDF1F2;margin-bottom:8px">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#4A5B66;letter-spacing:0.04em">techvibes / delivery</span>
          <span style="display:flex;align-items:center;gap:7px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#137565"><span style="width:7px;height:7px;border-radius:50%;background:#1B9C85;animation:tvPulse 2s infinite"></span>running</span>
        </div>
        <div style="position:relative;display:flex;flex-direction:column;gap:4px">
          <div aria-hidden="true" style="position:absolute;left:23px;top:22px;bottom:22px;width:2px;background:#E6ECED"></div>
          <div aria-hidden="true" data-rail style="position:absolute;left:23px;top:22px;width:2px;height:0px;background:linear-gradient(#1B9C85,#2A74CE);transition:height .6s ease"></div>
          
            <div data-stage="0" style="position:relative;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:8px;padding:12px 12px 12px 0;border-radius:12px;background:#F0F7F6;transition:background .4s ease">
              <div style="display:flex;justify-content:center"><span data-stage-dot style="width:14px;height:14px;border-radius:4px;background:#1B9C85;border:2px solid transparent;transition:all .4s ease"></span></div>
              <div style="display:flex;flex-direction:column;gap:2px">
                <span style="font-size:17px;font-weight:600;letter-spacing:-0.02em;color:#0F1E2A">Business</span>
                <span style="font-size:14px;color:#4A5B66">Your goals, customers and operations</span>
              </div>
              <span data-stage-num style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#137565">01</span>
            </div>
          
            <div data-stage="1" style="position:relative;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:8px;padding:12px 12px 12px 0;border-radius:12px;background:transparent;transition:background .4s ease">
              <div style="display:flex;justify-content:center"><span data-stage-dot style="width:14px;height:14px;border-radius:4px;background:#FFFFFF;border:2px solid #C9D4D7;transition:all .4s ease"></span></div>
              <div style="display:flex;flex-direction:column;gap:2px">
                <span style="font-size:17px;font-weight:600;letter-spacing:-0.02em;color:#0F1E2A">Technology</span>
                <span style="font-size:14px;color:#4A5B66">Websites, stores, apps and platforms</span>
              </div>
              <span data-stage-num style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8A99A2">02</span>
            </div>
          
            <div data-stage="2" style="position:relative;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:8px;padding:12px 12px 12px 0;border-radius:12px;background:transparent;transition:background .4s ease">
              <div style="display:flex;justify-content:center"><span data-stage-dot style="width:14px;height:14px;border-radius:4px;background:#FFFFFF;border:2px solid #C9D4D7;transition:all .4s ease"></span></div>
              <div style="display:flex;flex-direction:column;gap:2px">
                <span style="font-size:17px;font-weight:600;letter-spacing:-0.02em;color:#0F1E2A">AI</span>
                <span style="font-size:14px;color:#4A5B66">Models connected to your own data</span>
              </div>
              <span data-stage-num style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8A99A2">03</span>
            </div>
          
            <div data-stage="3" style="position:relative;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:8px;padding:12px 12px 12px 0;border-radius:12px;background:transparent;transition:background .4s ease">
              <div style="display:flex;justify-content:center"><span data-stage-dot style="width:14px;height:14px;border-radius:4px;background:#FFFFFF;border:2px solid #C9D4D7;transition:all .4s ease"></span></div>
              <div style="display:flex;flex-direction:column;gap:2px">
                <span style="font-size:17px;font-weight:600;letter-spacing:-0.02em;color:#0F1E2A">Automation</span>
                <span style="font-size:14px;color:#4A5B66">Repetitive work handled by systems</span>
              </div>
              <span data-stage-num style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8A99A2">04</span>
            </div>
          
            <div data-stage="4" style="position:relative;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:8px;padding:12px 12px 12px 0;border-radius:12px;background:transparent;transition:background .4s ease">
              <div style="display:flex;justify-content:center"><span data-stage-dot style="width:14px;height:14px;border-radius:4px;background:#FFFFFF;border:2px solid #C9D4D7;transition:all .4s ease"></span></div>
              <div style="display:flex;flex-direction:column;gap:2px">
                <span style="font-size:17px;font-weight:600;letter-spacing:-0.02em;color:#0F1E2A">Growth</span>
                <span style="font-size:14px;color:#4A5B66">More capacity, better decisions</span>
              </div>
              <span data-stage-num style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8A99A2">05</span>
            </div>
          
        </div>
      </div>
      <div class="hero-float" style="position:absolute;right:28px;bottom:0;width:260px;background:#0C1A24;color:#FFFFFF;border-radius:14px;padding:16px 18px;box-shadow:0 24px 48px -20px rgba(12,26,36,.55);display:flex;flex-direction:column;gap:10px">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#8FE0D0">Automation · new order</span>
          <div style="display:flex;flex-direction:column;gap:7px;font-size:13.5px;color:#D9E4EA">
            <span style="display:flex;gap:9px;align-items:center"><span style="color:#6FD3C0">✓</span>Stock synced</span>
            <span style="display:flex;gap:9px;align-items:center"><span style="color:#6FD3C0">✓</span>Invoice issued</span>
            <span style="display:flex;gap:9px;align-items:center"><span style="color:#7FB0EC">●</span>Customer updated</span>
          </div>
        </div>
      
    </div>
  </div>
</section>

<section data-screen-label="Trust strip" aria-label="Clients" style="border-top:1px solid #EAEFF0;border-bottom:1px solid #EAEFF0;background:#FAFBFB">
  <div class="trust-strip" style="max-width:1240px;margin:0 auto;padding:32px clamp(20px,4vw,40px);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px 48px">
    <span class="trust-label" style="font-size:14.5px;color:#4A5B66;max-width:220px;line-height:1.4">Trusted by entrepreneurs, startups, and SMEs</span>
    <div class="trust-logos" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px clamp(28px,4vw,56px);flex:1;justify-content:flex-end">
      <span style="font-family:Manrope,sans-serif;font-size:20px;font-weight:600;letter-spacing:-0.03em;color:#51616B">Swiglife</span>
      <span style="font-family:Manrope,sans-serif;font-size:20px;font-weight:600;letter-spacing:-0.03em;color:#51616B">Texas School Alliance</span>
      <span style="font-family:Manrope,sans-serif;font-size:20px;font-weight:600;letter-spacing:-0.03em;color:#51616B">Continental Ventures</span>
      <span style="font-family:Manrope,sans-serif;font-size:20px;font-weight:600;letter-spacing:-0.03em;color:#51616B">Rodriques Law</span>
    </div>
  </div>
</section>

<section id="services" data-screen-label="Services" style="background:#FFFFFF">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(80px,10vw,136px) clamp(20px,4vw,40px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)">
    <div data-reveal="1" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 64px;align-items:end">
      <div style="display:flex;flex-direction:column;gap:18px">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.12em;text-transform:uppercase;color:#137565">01 · Capabilities</span>
        <h2 style="font-family:Manrope,sans-serif;margin:0;font-size:clamp(34px,4.6vw,56px);font-weight:600;letter-spacing:-0.04em;line-height:1.04;text-wrap:balance">Technology that solves real business problems</h2>
      </div>
      <p style="margin:0;font-size:18px;line-height:1.6;color:#3C4B55;text-wrap:pretty">From high-performing websites and eCommerce platforms to AI agents and custom SaaS applications, we build technology around the way your business actually works.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1px;background:#E3E9EA;border:1px solid #E3E9EA;border-radius:16px;overflow:hidden">
      <a class="hv-3" data-reveal="1" href="/ai-automation/" style="background:#0C1A24;color:#FFFFFF;padding:32px;display:flex;flex-direction:column;gap:28px;min-height:340px;transition:background .3s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div style="display:grid;grid-template-columns:repeat(2,12px);gap:4px"><span style="height:12px;border-radius:3px;background:#2A3C49"></span><span style="height:12px;border-radius:3px;background:#2A3C49"></span><span style="height:12px;border-radius:3px;background:#2A3C49"></span><span style="height:12px;border-radius:0 0 12px 0;background:linear-gradient(135deg,#1B9C85,#2A74CE)"></span></div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8FA3AF">01</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:auto">
          <h3 style="font-family:Manrope,sans-serif;margin:0;font-size:26px;font-weight:600;letter-spacing:-0.03em">AI &amp; Automation</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15.5px;color:#C3D1D8">
            <li>AI agents</li><li>Workflow automation</li><li>Business process optimisation</li><li>AI-powered insights</li>
          </ul>
          <span style="font-size:15px;font-weight:500;color:#8FE0D0">Learn more →</span>
        </div>
      </a>
      <a class="hv-4" data-reveal="1" href="/shopify-development/" style="background:#FFFFFF;color:#0F1E2A;padding:32px;display:flex;flex-direction:column;gap:28px;min-height:340px;transition:background .3s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div style="display:grid;grid-template-columns:repeat(2,12px);gap:4px"><span style="height:12px;border-radius:3px;background:#1B9C85"></span><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:0 0 12px 0;background:#DDE5E7"></span></div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#5E6E78">02</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:auto">
          <h3 style="font-family:Manrope,sans-serif;margin:0;font-size:26px;font-weight:600;letter-spacing:-0.03em">Shopify Development</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15.5px;color:#3C4B55">
            <li>Store development</li><li>Custom Shopify apps</li><li>Theme customisation</li><li>Integrations</li><li>Maintenance</li>
          </ul>
          <span style="font-size:15px;font-weight:500;color:#137565">Learn more →</span>
        </div>
      </a>
      <a class="hv-4" data-reveal="1" href="/wordpress-development/" style="background:#FFFFFF;color:#0F1E2A;padding:32px;display:flex;flex-direction:column;gap:28px;min-height:340px;transition:background .3s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div style="display:grid;grid-template-columns:repeat(2,12px);gap:4px"><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:3px;background:#159FA8"></span><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:0 0 12px 0;background:#DDE5E7"></span></div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#5E6E78">03</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:auto">
          <h3 style="font-family:Manrope,sans-serif;margin:0;font-size:26px;font-weight:600;letter-spacing:-0.03em">WordPress &amp; WooCommerce</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15.5px;color:#3C4B55">
            <li>Custom websites</li><li>WooCommerce</li><li>Custom plugins</li><li>Custom themes</li><li>Performance and security</li>
          </ul>
          <span style="font-size:15px;font-weight:500;color:#137565">Learn more →</span>
        </div>
      </a>
      <a class="hv-4" data-reveal="1" href="/saas-app-development/" style="background:#FFFFFF;color:#0F1E2A;padding:32px;display:flex;flex-direction:column;gap:28px;min-height:340px;transition:background .3s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div style="display:grid;grid-template-columns:repeat(2,12px);gap:4px"><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:3px;background:#2A74CE"></span><span style="height:12px;border-radius:0 0 12px 0;background:#DDE5E7"></span></div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#5E6E78">04</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:auto">
          <h3 style="font-family:Manrope,sans-serif;margin:0;font-size:26px;font-weight:600;letter-spacing:-0.03em">SaaS Development</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15.5px;color:#3C4B55">
            <li>Platform development</li><li>AI-powered SaaS</li><li>APIs</li><li>Dashboards</li><li>Automation</li>
          </ul>
          <span style="font-size:15px;font-weight:500;color:#137565">Learn more →</span>
        </div>
      </a>
      <a class="hv-4" data-reveal="1" href="/mobile-app-development/" style="background:#FFFFFF;color:#0F1E2A;padding:32px;display:flex;flex-direction:column;gap:28px;min-height:340px;transition:background .3s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div style="display:grid;grid-template-columns:repeat(2,12px);gap:4px"><span style="height:12px;border-radius:3px;background:#1B9C85"></span><span style="height:12px;border-radius:3px;background:#DDE5E7"></span><span style="height:12px;border-radius:3px;background:#159FA8"></span><span style="height:12px;border-radius:0 0 12px 0;background:#DDE5E7"></span></div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#5E6E78">05</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:auto">
          <h3 style="font-family:Manrope,sans-serif;margin:0;font-size:26px;font-weight:600;letter-spacing:-0.03em">Mobile App Development</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15.5px;color:#3C4B55">
            <li>iOS</li><li>Android</li><li>Cross-platform applications</li><li>Deployment and optimisation</li>
          </ul>
          <span style="font-size:15px;font-weight:500;color:#137565">Learn more →</span>
        </div>
      </a>
      <a class="hv-5" data-reveal="1" href="/webflow-framer-design/" style="background:#F2F7F6;color:#0F1E2A;padding:32px;display:flex;flex-direction:column;gap:28px;min-height:340px;transition:background .3s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div style="display:grid;grid-template-columns:repeat(2,12px);gap:4px"><span style="height:12px;border-radius:3px;background:#1B9C85"></span><span style="height:12px;border-radius:3px;background:#159FA8"></span><span style="height:12px;border-radius:3px;background:#2A74CE"></span><span style="height:12px;border-radius:0 0 12px 0;background:linear-gradient(135deg,#159FA8,#2A74CE)"></span></div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#5E6E78">06</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:auto">
          <h3 style="font-family:Manrope,sans-serif;margin:0;font-size:26px;font-weight:600;letter-spacing:-0.03em">Webflow &amp; Framer</h3>
          <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15.5px;color:#3C4B55">
            <li>Webflow websites</li><li>Framer websites</li><li>Figma to Webflow or Framer</li><li>Platform migration</li><li>CMS and SEO setup</li>
          </ul>
          <span style="font-size:15px;font-weight:500;color:#137565">Learn more →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="solutions" data-screen-label="AI section" style="position:relative;background:#0C1A24;color:#FFFFFF;overflow:hidden">
  <div aria-hidden="true" style="position:absolute;left:-20%;bottom:-40%;width:900px;height:900px;border-radius:50%;background:radial-gradient(circle,rgba(27,156,133,.18) 0%,rgba(42,116,206,.08) 45%,transparent 70%)"></div>
  <div style="position:relative;max-width:1240px;margin:0 auto;padding:clamp(80px,10vw,136px) clamp(20px,4vw,40px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)">
    <div data-reveal="1" style="display:flex;flex-direction:column;gap:18px;max-width:820px">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.12em;text-transform:uppercase;color:#8FE0D0">02 · AI</span>
      <h2 style="font-family:Manrope,sans-serif;margin:0;font-size:clamp(36px,5.2vw,68px);font-weight:600;letter-spacing:-0.045em;line-height:1.02;text-wrap:balance">Put AI to work inside your business</h2>
      <p style="margin:0;font-size:18px;line-height:1.6;color:#B9C8D0;max-width:680px;text-wrap:pretty">We don't just add AI features. We integrate AI into real business processes to reduce repetitive work, improve customer experiences, and help teams make better decisions.</p>
    </div>
