---
import type { Project } from '../data/work';
import ProjectImage from './ProjectImage.astro';
interface Props { project: Project; href?: string }
const { project, href = project.url ?? '/work/' } = Astro.props;
const external = href.startsWith('http');
---
<a data-reveal href={href} class="featured-work" rel={external ? 'noopener' : undefined}>
  <div class="featured-work__media"><ProjectImage project={project} /></div>
  <div class="featured-work__body">
    <span class="mono featured-work__kicker">Featured case study</span>
    <h3 class="h3 featured-work__title">{project.name}</h3>
    {(project.category || project.stack || project.outcome) && (
      <dl class="featured-work__meta">
        {project.category && <><dt>Type</dt><dd>{project.category}</dd></>}
        {project.stack && <><dt>Technology</dt><dd>{project.stack}</dd></>}
        {project.outcome && <><dt>Outcome</dt><dd>{project.outcome}</dd></>}
      </dl>
    )}
    <span class="link-arrow">View case study →</span>
  </div>
</a>

<style>
  .featured-work {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    border: 1px solid var(--line-2); border-radius: 18px; overflow: hidden; color: var(--ink);
    transition: box-shadow .3s ease;
  }
  .featured-work:hover { box-shadow: 0 30px 60px -30px rgba(12,26,36,.3); color: var(--ink); }
  .featured-work__media { position: relative; min-height: 360px; background: #EAF0F0; }
  .featured-work__body { padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 20px; justify-content: center; }
  .featured-work__kicker { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal-dark); }
  .featured-work__title { font-size: clamp(30px, 3.6vw, 44px); letter-spacing: -0.04em; }
  .featured-work__meta { margin: 0; display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px 16px; font-size: 15.5px; }
  .featured-work__meta dt { color: var(--muted); }
  .featured-work__meta dd { margin: 0; color: var(--ink); }
</style>
