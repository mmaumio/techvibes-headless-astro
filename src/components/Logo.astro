---
import Mark from './Mark.astro';
interface Props { href?: string; large?: boolean }
const { href = '/', large = false } = Astro.props;
---
<a href={href} aria-label="TechVibes IT home" class:list={['logo', { 'logo--lg': large }]}>
  <Mark size={large ? 32 : 30} />
  <span class="logo__word">TechV<span class="logo__i">ı<span class="logo__dot"></span></span>bes</span>
</a>

<style>
  .logo { display: flex; align-items: center; gap: 11px; color: var(--ink); }
  .logo:hover { color: var(--ink); }
  .logo__word {
    font-family: var(--font-logo); font-weight: 600; font-size: 25px;
    letter-spacing: -0.04em; line-height: 1; color: var(--ink);
  }
  /* Header size: about 7% larger, in step with the 16px menu */
  .logo--lg { gap: 12px; }
  .logo--lg .logo__word { font-size: 26.7px; }
  .logo__i { position: relative; display: inline-block; padding-left: 0.03em; }
  .logo__dot {
    position: absolute; left: 50%; top: 0.08em; width: 0.13em; height: 0.13em; margin-left: -0.05em;
    border-radius: 0 0 100% 0; background: var(--grad);
  }
</style>
