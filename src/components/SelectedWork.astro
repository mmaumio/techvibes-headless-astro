---
import { projects } from '../data/work';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';

const featured = projects.find((p) => p.featured) ?? projects[0];
const rest = projects.filter((p) => p !== featured && p.home !== false);
---
<section id="work" style="background:#FFFFFF">
  <div class="container section stack" style="gap:clamp(40px,5vw,56px)">
    <div data-reveal style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
      <div class="stack" style="gap:18px">
        <span class="eyebrow">07 · Work</span>
        <h2 class="h2">Featured work</h2>
      </div>
      <a href="/work/" style="font-size:16px;font-weight:500">View all work →</a>
    </div>
    <FeaturedProject project={featured} />
    <div class="grid-auto selected-work__grid" style="--min:240px">
      {rest.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</section>

<style>
  /* Wide screens: all homepage cards in one row (columns = number of cards).
     Smaller screens: 2 columns, then 1 on phones. */
  .selected-work__grid { display: grid; gap: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1100px) { .selected-work__grid { grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); } }
  @media (max-width: 480px) { .selected-work__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
