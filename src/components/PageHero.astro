---
interface Props { eyebrow?: string; title: string; intro?: string; wide?: boolean }
const { eyebrow, title, intro, wide = false } = Astro.props;
---
<section class="page-hero">
  <div class="page-hero__grid" aria-hidden="true"></div>
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="page-hero__inner" style={wide ? 'max-width:1040px' : undefined}>
      {eyebrow && <span class="eyebrow eyebrow--dot">{eyebrow}</span>}
      <h1 class="h1" set:html={title} />
      {intro && <p class="lead" style="max-width:640px">{intro}</p>}
      <slot />
    </div>
  </div>
</section>
