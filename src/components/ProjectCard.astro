---
import type { Project } from '../data/work';
import ProjectImage from './ProjectImage.astro';
interface Props { project: Project }
const { project } = Astro.props;
const href = project.url ?? '/work/';
const meta = [project.category, project.stack, project.outcome].filter(Boolean).join(' · ');
---
<a data-reveal href={href} class="card project-card" rel={href.startsWith('http') ? 'noopener' : undefined}>
  <div class="project-card__media"><ProjectImage project={project} /></div>
  <div class="project-card__body">
    <h3 class="h3 project-card__title">{project.name}</h3>
    {meta && <span class="project-card__meta">{meta}</span>}
    <span class="link-arrow" style="padding-top:6px">View case study →</span>
  </div>
</a>

<style>
  .project-card { overflow: hidden; }
  .project-card__media { position: relative; aspect-ratio: 4 / 3; background: #EAF0F0; }
  .project-card__body { padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .project-card__title { font-size: 20px; letter-spacing: -0.025em; }
  .project-card__meta { font-size: 14.5px; color: var(--muted-2); }
</style>
