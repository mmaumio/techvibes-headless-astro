---
// Project image: src/assets/images/work-<project-name>.(jpg|png|webp).
// Logos are shown whole on white; set logo: false in work.ts for a
// screenshot or photo that should fill the frame instead.
import type { Project } from '../data/work';
import SiteImage from './SiteImage.astro';
import { slugify } from '../lib/images';

interface Props { project: Project; large?: boolean }
const { project, large = false } = Astro.props;
const name = `work-${slugify(project.name)}`;
---
<SiteImage
  name={name}
  alt={`${project.name} logo`}
  fit={project.logo === false ? 'cover' : 'logo'}
  logoSize={large ? 300 : 200}
/>
